# Copy to .env. Every value is optional; the defaults below match docker-compose.yml.
#
# This file configures Docker Compose only. Laravel reads backend/.env, which the
# backend container never relies on: everything it needs is passed explicitly
# through the `environment:` block in docker-compose.yml.
#
# APP_URL is the URL the backend is reached at from your browser, and the one
# Vite and CORS must agree on. If you change a published port in
# docker-compose.yml, change this to match.

APP_NAME=ClientPulse
APP_URL=http://localhost:8000

POSTGRES_DB=clientpulse
POSTGRES_USER=clientpulse
POSTGRES_PASSWORD=clientpulse