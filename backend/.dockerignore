# The application is bind-mounted at runtime and dependencies live in volumes,
# so nothing below is ever sent to the daemon. Kept as a safety net against
# baking a local environment into an image.
.git
.agents
.claude
.cursor
.zed
.idea
.vscode
.env
.env.*
!.env.example
node_modules
vendor
database/*.sqlite
public/build
public/hot
public/storage
storage/framework
storage/logs
tests
*.log